# Lulimi Lingo - Backend Environment Configuration
# =================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============ AI MODEL CONFIGURATION ============

# Primary Model Selection: "local", "gemini", "openai"
AI_PROVIDER=local

# Local Model (fine-tuned model)
LOCAL_MODEL_PATH=./models/luganda-tutor
LOCAL_MODEL_NAME=google/gemma-2b-it
USE_QUANTIZATION=true

# Google Gemini (Free tier - recommended for lesson/quiz generation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Translation (paid)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-nano

# ============ FINE-TUNING CONFIGURATION ============

# Training settings
TRAINING_DATA_PATH=./data/training
OUTPUT_MODEL_PATH=./models/luganda-tutor
EPOCHS=3
BATCH_SIZE=4
LEARNING_RATE=2e-4
MAX_SEQ_LENGTH=512

# LoRA Configuration (for efficient fine-tuning)
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# ============ DATABASE ============

DATABASE_URL=sqlite+aiosqlite:///./data/lulimi_lingo.db

# ============ LOGGING ============

LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log
